# 统一换行符:仓库内一律存 LF,避免 Windows 协作时整文件 diff 抖动
* text=auto eol=lf

# 明确按文本处理
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.example text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制,不做转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
