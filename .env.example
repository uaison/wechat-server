# ===========================================
# 服务配置
# ===========================================
NODE_ENV=development
PORT=3000
# 对外访问的基础地址(用于日志与回调 URL 提示)
BASE_URL=http://localhost:3000

LOG_LEVEL=info

# ===========================================
# MySQL 配置
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wechat_server
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===========================================
# 敏感字段加密密钥(用于加密 app_secret / aes_key 等)
# 生成方式: npm run keygen
# 必须是 64 位十六进制字符(32 字节)
# ⚠️ 此密钥一旦丢失,已加密的数据将无法解密!
# ===========================================
ENCRYPT_KEY=

# ===========================================
# HTTP 请求微信接口的超时(毫秒)
# ===========================================
WECHAT_REQUEST_TIMEOUT=10000

# access_token 提前刷新的安全边际(毫秒),默认 5 分钟
TOKEN_REFRESH_MARGIN_MS=300000
